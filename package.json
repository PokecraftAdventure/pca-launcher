{
    "name": "pokecraft-adventure-launcher",
    "productName": "Pokecraft Adventure",
    "appId": "com.pokecraftadventure.launcher",
    "version": "0.1.1",
    "description": "Launcher de Pokecraft Adventure",
    "main": "src/app.js",
    "author": {
        "name": "Pokecraft Adventure"
    },
    "url": "",
    "scripts": {
        "start": "cross-env-shell NODE_ENV=dev electron .",
        "dev": "cross-env-shell DEV_TOOL=open nodemon --exec npm start",
        "build": "node build.js --obf=true --build=platform",
        "icon": "node build.js --icon",
        "manifest": "node tools/build-assets-manifest.js"
    },
    "license": "CCANC",
    "nodemonConfig": {
        "ext": "js,html,css",
        "ignore": "**/test"
    },
    "dependencies": {
        "electron-store": "^8.2.0",
        "electron-updater": "^6.7.3",
        "minecraft-java-core": "^4.2.5",
        "node-fetch": "^2.7.0",
        "yauzl": "^3.4.0",
        "yazl": "^3.3.1"
    },
    "devDependencies": {
        "cross-env": "^10.1.0",
        "electron": "^40.0.0",
        "electron-builder": "^26.0.12",
        "javascript-obfuscator": "^5.1.0",
        "jimp": "^1.6.0",
        "nodemon": "^3.1.11",
        "png2icons": "^2.0.1"
    }
}
